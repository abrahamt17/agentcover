# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real keys.

# --- Required: Supabase project (Project Settings -> API) ---------------------
# Both values are public by design; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required: public origin of this app ---------------------------------------
# Used to build links in verification, password-reset and invitation emails.
# Must also be listed under Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: demo seed script only (npm run seed:demo) -----------------------
# The application itself never reads these. Do NOT set them in your hosting
# provider's environment; use them from your own shell against a non-production
# project only.
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_USER_PASSWORD=
# DEMO_SEED_CONFIRM=
